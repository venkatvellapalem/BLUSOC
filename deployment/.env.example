# ==============================================================================
# BLUSOC Zero-Touch Server Deployment Environment Configuration
# ==============================================================================
# Copy this template to .env before executing deploy.sh:
#   cp .env.example .env
#
# Constraints and Guidelines:
# - All company IPs must reside within RFC 1918 / RFC 5737 ranges (10.240.0.0/16, 198.51.100.0/24).
# - All hostnames must use synthetic internal domains (*.blusoc.internal).
# - Zero corporate secrets: Replace all placeholder tokens with production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Wazuh SIEM Manager Configuration
# ------------------------------------------------------------------------------
# Primary IP or FQDN of the Wazuh Manager instance
WAZUH_MANAGER_IP=10.240.0.10

# Wazuh RESTful API listener port (default: 55000)
WAZUH_API_PORT=55000

# Administrative API user for Wazuh management
WAZUH_API_USER=wazuh-wui

# Password for the Wazuh API user (generate with: openssl rand -base64 24)
WAZUH_API_PASSWORD=Placeholder_ChangeInProduction_WazuhApiPassword_2026!

# 128-bit hexadecimal cluster communication key (32 hex characters)
WAZUH_CLUSTER_KEY=0123456789abcdef0123456789abcdef

# Wazuh manager version to install
WAZUH_VERSION=4.9.0

# Wazuh agent registration auth port (default: 1515)
WAZUH_REGISTRATION_PORT=1515

# Wazuh secure event communication port (default: 1514)
WAZUH_EVENTS_PORT=1514

# ------------------------------------------------------------------------------
# 2. DFIR-IRIS Case Management & SOAR Stack
# ------------------------------------------------------------------------------
# Public or internal base URL for DFIR-IRIS instance
IRIS_API_URL=https://soar-iris-01.blusoc.internal

# API token for custom-iris and iris_status_daemon authentication
# Generated from IRIS UI: User Profile -> API Tokens -> Add Token
IRIS_API_KEY=iris_api_token_placeholder_generate_in_iris_ui

# Default customer / client organization identifier in IRIS (integer)
IRIS_CUSTOMER_ID=1

# HMAC shared secret for securing incoming IRIS webhook alerts
IRIS_WEBHOOK_SECRET=Placeholder_WebhookSharedSecret_32CharsMin!

# PostgreSQL database user for IRIS backend
POSTGRES_USER=iris_user

# PostgreSQL database password for IRIS backend
POSTGRES_PASSWORD=Placeholder_IrisPostgresPassword_ChangeMe!

# PostgreSQL database name for IRIS backend
POSTGRES_DB=iris_db

# PostgreSQL host address for IRIS (container service name or internal IP)
POSTGRES_HOST=10.240.0.11
POSTGRES_PORT=5432

# RabbitMQ message broker credentials
RABBITMQ_DEFAULT_USER=iris_mq
RABBITMQ_DEFAULT_PASS=Placeholder_IrisRabbitMqPassword_ChangeMe!

# Django secret key for IRIS web application (generate with: openssl rand -hex 32)
IRIS_SECRET_KEY=Placeholder_IrisDjangoSecretKey_64CharsRandom!

# Web server name for IRIS Nginx reverse proxy
IRIS_SERVER_NAME=soar-iris-01.blusoc.internal
IRIS_APP_PORT=443

# ------------------------------------------------------------------------------
# 3. Telemetry Integrations & Threat Intelligence
# ------------------------------------------------------------------------------
# CrowdStrike Falcon API credentials for telemetry streaming
CROWDSTRIKE_CLIENT_ID=placeholder_crowdstrike_client_id
CROWDSTRIKE_CLIENT_SECRET=placeholder_crowdstrike_client_secret

# Sophos Central API credentials for endpoint telemetry
SOPHOS_CLIENT_ID=placeholder_sophos_client_id
SOPHOS_CLIENT_SECRET=placeholder_sophos_client_secret

# Barracuda CloudGen Firewall syslog listener port (UDP/TCP)
BARRACUDA_SYSLOG_PORT=514
BARRACUDA_SYSLOG_SECURE_PORT=6514

# Cloudflare WAF integration credentials for threat log ingestion
CLOUDFLARE_API_TOKEN=placeholder_cloudflare_api_token
CLOUDFLARE_ZONE_ID=placeholder_cloudflare_zone_id

# VirusTotal API v3 key for automated IOC hash and IP lookups (64 hex characters)
VIRUSTOTAL_API_KEY=placeholder_virustotal_api_key_64chars

# MISP Threat Sharing Platform endpoint and authentication
MISP_API_URL=https://misp.blusoc.internal
MISP_API_KEY=placeholder_misp_api_key_40chars

# ------------------------------------------------------------------------------
# 4. Web Application Showcase & Database
# ------------------------------------------------------------------------------
# Neon or local PostgreSQL database connection string
DATABASE_URL=postgresql://iris_user:Placeholder_IrisPostgresPassword_ChangeMe@localhost:5432/iris_db?sslmode=require

# Encryption secret for signing guest workspace session cookies
SESSION_SECRET=placeholder_session_secret_at_least_32_characters_long

# Fully qualified public URL for the Next.js showcase web application
NEXT_PUBLIC_APP_URL=https://blusoc.internal

# ------------------------------------------------------------------------------
# 5. Background Synchronization & Diagnostics Daemon
# ------------------------------------------------------------------------------
# Query endpoint for polling ticket state transitions
IRIS_ENDPOINT=https://soar-iris-01.blusoc.internal/alerts/filter

# Polling interval in seconds (default: 10)
IRIS_POLL_INTERVAL=10

# Audit log target file for ticket synchronization events
IRIS_AUDIT_LOG=/var/log/blusoc/iris_sync_audit.log

# Global logging verbosity (DEBUG, INFO, WARNING, ERROR)
BLUSOC_LOG_LEVEL=INFO

# Target deployment environment (production, staging, development, test)
BLUSOC_DEPLOY_ENV=production
