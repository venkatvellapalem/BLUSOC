# BLUSOC SOC server configuration. The website does not use this file.
# Generate a private file: python3 config.py init
# Format: one KEY=value per line; optional outer quotes are removed literally.
# No shell expansion, inline comments, or multiline values. Never commit .env.

# Exact APT package version. Check the Wazuh 4.x repository before changing it.
WAZUH_VERSION=4.14.10-1
WAZUH_EVENTS_PORT=1514
WAZUH_REGISTRATION_PORT=1515
WAZUH_ENROLLMENT_PASSWORD=__SET_WAZUH_ENROLLMENT_PASSWORD__

# Stable upstream 2.4 release; app, database, and proxy tags stay in sync.
IRIS_VERSION=v2.4.29
# Defaults expose IRIS only on loopback. Use an SSH tunnel for remote access.
IRIS_SERVER_NAME=localhost
IRIS_API_URL=https://localhost:8443
IRIS_HTTPS_PORT=8443
IRIS_BIND_ADDRESS=127.0.0.1
# self-signed: generate a SAN certificate and trust it locally.
# provided: supply iris.crt and iris.key in /opt/blusoc/iris/certificates/web_certificates.
IRIS_TLS_MODE=self-signed
# Used to bootstrap the IRIS administrator API token on the first database initialization.
IRIS_API_KEY=__SET_IRIS_API_KEY__
IRIS_ADMIN_PASSWORD=__SET_IRIS_ADMIN_PASSWORD__
IRIS_CUSTOMER_ID=1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=__SET_POSTGRES_PASSWORD__
POSTGRES_ADMIN_USER=iris_admin
POSTGRES_ADMIN_PASSWORD=__SET_POSTGRES_ADMIN_PASSWORD__
POSTGRES_DB=iris_db
IRIS_SECRET_KEY=__SET_IRIS_SECRET_KEY__
IRIS_SECURITY_PASSWORD_SALT=__SET_IRIS_SECURITY_PASSWORD_SALT__
RABBITMQ_USER=iris_mq
RABBITMQ_PASSWORD=__SET_RABBITMQ_PASSWORD__

# Status monitor writes an audit log; it does not mutate Wazuh or the showcase.
IRIS_POLL_INTERVAL=10

# Plain syslog on an explicitly scoped listener. No pretend TLS on port 6514.
# Set a private interface and your actual sensor CIDR to receive remote logs.
SYSLOG_BIND_ADDRESS=127.0.0.1
SYSLOG_PORT=514
SYSLOG_ALLOWED_NETWORK=10.240.0.0/16
