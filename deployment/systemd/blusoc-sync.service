[Unit]
Description=BLUSOC IRIS alert status monitor
Documentation=https://github.com/venkatvellapalem/BLUSOC
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=blusoc
Group=blusoc
WorkingDirectory=/opt/blusoc
EnvironmentFile=/etc/blusoc/blusoc.env
ExecStart=/opt/blusoc/venv/bin/python /opt/blusoc/bin/iris_status_daemon.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/blusoc /var/log/blusoc/iris-status
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blusoc-sync

[Install]
WantedBy=multi-user.target
