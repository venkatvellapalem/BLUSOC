<!--
  BLUSOC Production Wazuh Manager Configuration Template
  Location: /var/ossec/etc/ossec.conf
  Generated by: BLUSOC Zero-Touch Deployment Suite
  Note: Environment variables ${VARIABLE_NAME} are interpolated during 02_wazuh_provision.sh
-->
<ossec_config>
  <global>
    <jsonout_output>yes</jsonout_output>
    <alerts_log>yes</alerts_log>
    <logall>no</logall>
    <logall_json>no</logall_json>
    <email_notification>no</email_notification>
    <smtp_server>127.0.0.1</smtp_server>
    <email_from>wazuh@blusoc.internal</email_from>
    <email_to>soc-alerts@blusoc.internal</email_to>
    <email_maxperhour>12</email_maxperhour>
    <email_log_summary>12</email_log_summary>

    <!-- Trusted internal RFC 1918 and documentation networks -->
    <white_list>127.0.0.1</white_list>
    <white_list>^localhost.localdomain$</white_list>
    <white_list>10.240.0.0/16</white_list>
    <white_list>172.16.50.0/24</white_list>
    <white_list>198.51.100.0/24</white_list>
  </global>

  <alerts>
    <log_alert_level>3</log_alert_level>
    <email_alert_level>12</email_alert_level>
  </alerts>

  <!-- High-throughput pipeline buffer sizing -->
  <remote>
    <connection>secure</connection>
    <port>${WAZUH_EVENTS_PORT}</port>
    <protocol>tcp</protocol>
    <queue_size>131072</queue_size>
    <rids_closing_time>300</rids_closing_time>
  </remote>

  <!-- Agent auto-enrollment daemon -->
  <auth>
    <disabled>no</disabled>
    <port>${WAZUH_REGISTRATION_PORT}</port>
    <use_source_ip>no</use_source_ip>
    <purge>yes</purge>
    <use_password>no</use_password>
    <ciphers>HIGH:!ADH:!EXP:!MD5:!RC4:!3DES:!CAMELLIA:@STRENGTH</ciphers>
    <ssl_verify_host>no</ssl_verify_host>
    <ssl_manager_cert>/var/ossec/etc/sslmanager.cert</ssl_manager_cert>
    <ssl_manager_key>/var/ossec/etc/sslmanager.key</ssl_manager_key>
    <ssl_auto_negotiate>no</ssl_auto_negotiate>
  </auth>

  <!-- BLUSOC Custom Rulesets and Tuning Overlays -->
  <ruleset>
    <!-- Default Wazuh rules and decoders -->
    <decoder_dir>ruleset/decoders</decoder_dir>
    <rule_dir>ruleset/rules</rule_dir>
    <rule_exclude>0215-policy_rules.xml</rule_exclude>
    <list>etc/lists/audit-keys</list>

    <!-- BLUSOC User Rules -->
    <decoder_dir>etc/decoders</decoder_dir>
    <rule_dir>etc/rules</rule_dir>
    <rule>etc/rules/01_suppression_rules.xml</rule>
    <rule>etc/rules/02_proxy_egress_tuning.xml</rule>
    <rule>etc/rules/03_threat_intel_rules.xml</rule>
  </ruleset>

  <!-- File Integrity Monitoring (FIM) -->
  <syscheck>
    <disabled>no</disabled>
    <frequency>43200</frequency>
    <scan_on_start>yes</scan_on_start>
    <alert_new_files>yes</alert_new_files>
    <auto_ignore frequency="10" timeframe="3600">no</auto_ignore>

    <!-- Critical system binaries and configuration paths -->
    <directories check_all="yes" realtime="yes">/etc,/usr/bin,/usr/sbin</directories>
    <directories check_all="yes" realtime="yes">/var/ossec/etc,/var/ossec/integrations</directories>

    <!-- Noise exclusions -->
    <ignore>/etc/mtab</ignore>
    <ignore>/etc/hosts.deny</ignore>
    <ignore>/etc/mail/statistics</ignore>
    <ignore>/etc/random-seed</ignore>
    <ignore>/etc/adjtime</ignore>
    <ignore>/etc/dumpdates</ignore>

    <!-- Suppress diff inspection on sensitive cryptographic keys -->
    <nodiff>/var/ossec/etc/sslmanager.key</nodiff>
    <nodiff>/etc/ssl/private</nodiff>
  </syscheck>

  <!-- Rootkit and anomaly detection -->
  <rootcheck>
    <disabled>no</disabled>
    <check_files>yes</check_files>
    <check_trojans>yes</check_trojans>
    <check_dev>yes</check_dev>
    <check_sys>yes</check_sys>
    <check_pids>yes</check_pids>
    <check_ports>yes</check_ports>
    <check_if>yes</check_if>
    <frequency>43200</frequency>
    <rootkit_files>etc/rootcheck/rootkit_files.txt</rootkit_files>
    <rootkit_trojans>etc/rootcheck/rootkit_trojans.txt</rootkit_trojans>
  </rootcheck>

  <!-- DFIR-IRIS Custom Integration Hook -->
  <integration>
    <name>custom-iris</name>
    <api_key>${IRIS_API_KEY}</api_key>
    <hook_url>${IRIS_API_URL}/alerts/add</hook_url>
    <alert_format>json</alert_format>
    <level>6</level>
  </integration>

  <!-- Sensor Log Ingestion Channels -->
  <!-- Suricata EVE JSON Telemetry -->
  <localfile>
    <log_format>json</log_format>
    <location>/var/log/suricata/eve.json</location>
  </localfile>

  <!-- Edge Firewall Syslog Stream (Barracuda / Sophos) -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/blusoc/firewall.log</location>
  </localfile>

  <!-- Cloudflare WAF Ingestion Stream -->
  <localfile>
    <log_format>json</log_format>
    <location>/var/log/blusoc/waf.log</location>
  </localfile>

  <!-- Host Authentication and System Telemetry -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/auth.log</location>
  </localfile>

  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/syslog</location>
  </localfile>
</ossec_config>
